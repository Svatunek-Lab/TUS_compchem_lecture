# Acetone: orbital energies + cube files of HOMO, LUMO and electron density
# (structure: PubChem CID 180)
! B3LYP def2-SVP

%plots
  Format Gaussian_Cube
  dim1 80
  dim2 80
  dim3 80
  min1 -8.0
  max1  8.0
  min2 -8.0
  max2  8.0
  min3 -8.0
  max3  8.0
  MO("acetone_homo.cube", 15, 0);
  MO("acetone_lumo.cube", 16, 0);
  ElDens("acetone_dens.cube");
end

